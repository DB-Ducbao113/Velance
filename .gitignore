# Source-only assets (kept locally, not published)
assets/models_original/
assets/models_prepared/
assets/images/**/*.png

# Dependencies & scratch
node_modules/
*.log
.DS_Store

# Fleet Operations telemetry database (local-only)
tools/ops/telemetry.db*

# Private local maintenance scratch and generated immutable release previews
tools/ops/backups/
tools/ops/scratch/
tools/delivery/releases/

# Defense in depth: local credentials, keys, private environment files.
# Git ignores do not protect secrets already tracked in history.
.env
.env.*
.env*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
