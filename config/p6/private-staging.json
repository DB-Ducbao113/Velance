{
  "format": "velance-p6-private-staging/1",
  "purpose": "synthetic-or-cleared-assets-only",
  "deployEnabled": false,
  "publicLaunchAuthorized": false,
  "origin": {
    "publicRead": false,
    "publicList": false,
    "privateServiceIdentityRequired": true,
    "directOriginBypassDenied": true,
    "immutableReleasePath": "/r/<sha256>/..."
  },
  "edge": {
    "httpsRequired": true,
    "tlsCertificateProviderTestRequired": true,
    "wafRequired": true,
    "rateLimitRequired": true,
    "originAuthRequired": true,
    "cacheKey": "canonical-path+representation",
    "allow": [
      "GET /", "HEAD /", "GET /index.html", "HEAD /index.html",
      "GET /r/<sha256>/<public-file>", "HEAD /r/<sha256>/<public-file>"
    ],
    "telemetry": {
      "enabled": false,
      "explicitOptInRequired": true,
      "onlyWhenApproved": "POST /api/telemetry",
      "requestCapBytes": 262144,
      "cache": "no-store"
    },
    "denyByDefault": true,
    "immutableCache": "public, max-age=31536000, immutable",
    "pointerCache": "no-store"
  },
  "privateServices": {
    "opsDashboard": "SSO+MFA+RBAC+private-network-only",
    "readApis": "private-only",
    "metrics": "private-only",
    "health": "private-only",
    "database": "single-writer-persistent-storage",
    "bind": "127.0.0.1",
    "offHostEncryptedBackupRequired": true
  },
  "gates": {
    "legalAssetReview": "BLOCKED",
    "providerTlsWafIamCdn": "NEEDS_PROVIDER_TEST",
    "opsIdentity": "NEEDS_PROVIDER_TEST",
    "privacyOwnerSignoff": "BLOCKED",
    "offHostRecovery": "NEEDS_PROVIDER_TEST",
    "externalAlertDelivery": "NEEDS_PROVIDER_TEST",
    "wanSoakAndDevices": "NEEDS_PROVIDER_TEST",
    "releaseCanaryRollback": "NEEDS_PROVIDER_TEST"
  }
}
